<?xml version="1.0" encoding="utf-8"?>
<!-- Layout realizat cu ajutorul Inteligentei Artificiale (design Material 3) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ai_fundal"
    android:fillViewport="true"
    tools:context=".ActivitateAI">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Antet cu gradient -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_ai"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍽️"
                android:textSize="40sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Adauga mancare"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Completeaza detaliile preparatului"
                android:textColor="#E6FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Card: informatii de baza -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="-16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/ai_card"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/AiTitluSectiune"
                    android:text="Informatii de baza" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Denumire"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/ai_primar"
                    app:hintTextColor="@color/ai_primar">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDenumire"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Calorii"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/ai_primar"
                    app:hintTextColor="@color/ai_primar"
                    app:suffixText="kcal">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCalorii"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/AiEticheta"
                    android:layout_marginTop="16dp"
                    android:text="Bucatarie" />

                <Spinner
                    android:id="@+id/spBucatarie"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:entries="@array/bucatarii" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: tip preparat -->
        <com.google.android.material.card.MaterialCardView
            style="@style/AiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/AiTitluSectiune"
                    android:text="Tip preparat" />

                <RadioGroup
                    android:id="@+id/rgTip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbFelPrincipal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="Fel principal"
                        android:textColor="@color/ai_text"
                        app:buttonTint="@color/ai_primar" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/rbDesert"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Desert"
                        android:textColor="@color/ai_text"
                        app:buttonTint="@color/ai_primar" />
                </RadioGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: preferinte -->
        <com.google.android.material.card.MaterialCardView
            style="@style/AiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/AiTitluSectiune"
                    android:text="Preferinte" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbVegetarian"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🥦  Vegetarian"
                    android:textColor="@color/ai_text"
                    android:textSize="16sp"
                    app:buttonTint="@color/ai_primar" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swPicant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="🌶️  Picant"
                    android:textColor="@color/ai_text"
                    android:textSize="16sp"
                    app:thumbTint="@android:color/white"
                    app:trackTint="@color/ai_primar" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: rating -->
        <com.google.android.material.card.MaterialCardView
            style="@style/AiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/AiTitluSectiune"
                    android:layout_gravity="start"
                    android:text="Cat de buna este?" />

                <RatingBar
                    android:id="@+id/rbRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:progressBackgroundTint="@color/ai_contur"
                    android:progressTint="@color/ai_primar"
                    android:secondaryProgressTint="@color/ai_primar"
                    android:stepSize="0.5" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalveaza"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            android:backgroundTint="@color/ai_primar"
            android:onClick="culegeDateMancare"
            android:text="Salveaza mancarea"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            app:cornerRadius="18dp" />
    </LinearLayout>
</ScrollView>
