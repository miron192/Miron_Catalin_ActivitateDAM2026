<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Stiluri pentru activitatea realizata cu AI -->
    <style name="AiTitluSectiune">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textColor">@color/ai_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AiEticheta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ai_text_secundar</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="AiCard">
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="cardBackgroundColor">@color/ai_card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/ai_contur</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
